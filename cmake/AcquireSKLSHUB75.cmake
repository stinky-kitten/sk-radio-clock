# One version/checksum record is shared with Package.swift.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../Dependencies/SKLSHUB75.json" _hub75_pin)
string(JSON _hub75_version GET "${_hub75_pin}" version)
string(JSON _hub75_url GET "${_hub75_pin}" asset_url)
string(JSON _hub75_hash GET "${_hub75_pin}" asset_sha256)
set(SKLSHUB75_ROOT "$ENV{SKLSHUB75_ROOT}" CACHE PATH "Optional unpacked SKLSHUB75 binary override")

if(NOT SKLSHUB75_ROOT)
    # A local ZIP can exercise the identical hash/extraction path for offline builds.
    set(SKLSHUB75_ARCHIVE "" CACHE FILEPATH "Optional offline copy of the pinned release ZIP")
    set(_hub75_download "${CMAKE_BINARY_DIR}/_deps/skls-hub75-${_hub75_hash}.zip")
    if(SKLSHUB75_ARCHIVE)
        set(_hub75_download "${SKLSHUB75_ARCHIVE}")
    else()
        if(EXISTS "${_hub75_download}")
            file(SHA256 "${_hub75_download}" _hub75_cached_hash)
            if(NOT _hub75_cached_hash STREQUAL _hub75_hash)
                file(REMOVE "${_hub75_download}")
            endif()
        endif()
        if(NOT EXISTS "${_hub75_download}")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/_deps")
            message(STATUS "Downloading pinned SKLSHUB75 ${_hub75_version}")
            file(DOWNLOAD "${_hub75_url}" "${_hub75_download}.part"
                STATUS _hub75_status TLS_VERIFY ON TIMEOUT 60 INACTIVITY_TIMEOUT 15)
            list(GET _hub75_status 0 _hub75_code)
            if(NOT _hub75_code EQUAL 0)
                file(REMOVE "${_hub75_download}.part")
                message(FATAL_ERROR
                    "SKLSHUB75 ${_hub75_version} download failed: ${_hub75_status}. "
                    "URL: ${_hub75_url}. "
                    "For offline development, set SKLSHUB75_ROOT to an unpacked binary package "
                    "or SKLSHUB75_ARCHIVE to the exact pinned ZIP. No source fallback exists.")
            endif()
            file(RENAME "${_hub75_download}.part" "${_hub75_download}")
        endif()
    endif()
    if(NOT EXISTS "${_hub75_download}")
        message(FATAL_ERROR "Pinned SKLSHUB75 archive is missing: ${_hub75_download}")
    endif()
    file(SHA256 "${_hub75_download}" _hub75_actual_hash)
    if(NOT _hub75_actual_hash STREQUAL _hub75_hash)
        message(FATAL_ERROR "SKLSHUB75 archive SHA-256 mismatch: expected ${_hub75_hash}, got ${_hub75_actual_hash}")
    endif()
    set(_hub75_extract "${CMAKE_BINARY_DIR}/_deps/skls-hub75-${_hub75_hash}")
    set(SKLSHUB75_ROOT "${_hub75_extract}/skls-hub75-${_hub75_version}-rp2350-arm-s")
    if(NOT EXISTS "${SKLSHUB75_ROOT}/manifest.json")
        file(ARCHIVE_EXTRACT INPUT "${_hub75_download}" DESTINATION "${_hub75_extract}")
    endif()
    # Check every cached payload file against the published release pin.
    string(JSON _hub75_count LENGTH "${_hub75_pin}" component_sha256)
    math(EXPR _hub75_last "${_hub75_count} - 1")
    foreach(_hub75_index RANGE 0 ${_hub75_last})
        string(JSON _hub75_file MEMBER "${_hub75_pin}" component_sha256 ${_hub75_index})
        string(JSON _hub75_expected GET "${_hub75_pin}" component_sha256 "${_hub75_file}")
        if(NOT EXISTS "${SKLSHUB75_ROOT}/${_hub75_file}")
            message(FATAL_ERROR "SKLSHUB75 payload missing ${_hub75_file}; remove the extracted _deps package and reconfigure")
        endif()
        file(SHA256 "${SKLSHUB75_ROOT}/${_hub75_file}" _hub75_actual)
        if(NOT _hub75_actual STREQUAL _hub75_expected)
            message(FATAL_ERROR "SKLSHUB75 payload checksum mismatch: ${_hub75_file}; remove the extracted _deps package and reconfigure")
        endif()
    endforeach()
    string(JSON _hub75_expected_manifest GET "${_hub75_pin}" manifest_sha256)
    file(SHA256 "${SKLSHUB75_ROOT}/manifest.json" _hub75_actual_manifest)
    if(NOT _hub75_actual_manifest STREQUAL _hub75_expected_manifest)
        message(FATAL_ERROR "SKLSHUB75 manifest checksum mismatch")
    endif()
endif()
get_filename_component(SKLSHUB75_ROOT "${SKLSHUB75_ROOT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
foreach(_hub75_required cmake/SKLSHUB75Config.cmake include/module.modulemap include/SKLSHUB75.apinotes lib/libskls_hub75.a)
    if(NOT EXISTS "${SKLSHUB75_ROOT}/${_hub75_required}")
        message(FATAL_ERROR "SKLSHUB75_ROOT is not an unpacked binary distribution: missing ${_hub75_required}")
    endif()
endforeach()
# Do not allow an old package-directory cache to override the selected root.
set(SKLSHUB75_DIR "${SKLSHUB75_ROOT}/cmake")
