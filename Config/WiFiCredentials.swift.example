// Copy to WiFiCredentials.swift. This local file is ignored by Git and review ZIPs.
// Keep .ntp for Wi-Fi timekeeping. Select .msf if you have wired an MSF receiver.
extension ClockConfiguration {
  static let current = ClockConfiguration(
    timeSource: .ntp,
    theme: .standard,
    timeZone: .uk,
    ntpServer: nil  // For NTP, enter your server's hostname or IPv4 address here.
  )
}

enum WiFiCredentials {
  static let ssid: StaticString = "YOUR_WIFI_SSID"
  static let password: StaticString = "YOUR_WIFI_PASSWORD"
}
